DATABASE_URL=postgresql://locus:YOUR_PASSWORD@127.0.0.1:5432/locus
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:3000","http://localhost:3000"]
# Local HTTP only; true on HTTPS deployments.
COOKIE_SECURE=false
# Server-only OpenRouter key. Never put this in frontend/VITE variables.
API_GEMMA=
# Ordered free-only failover chain (at most four models); no extra keys needed.
AI_FREE_MODELS=google/gemma-4-26b-a4b-it:free,qwen/qwen3.8-27b:free,deepseek/deepseek-v4-flash-0731:free,openrouter/free
